                                    <td class="p-3 border border-slate-200 dark:border-slate-700">Linear Velocity ($v$)</td>
                                    <td class="p-3 border border-slate-200 dark:border-slate-700">Angular Velocity ($\omega$)</td>
                                    <td class="p-3 border border-slate-200 dark:border-slate-700 font-mono">$v = r\omega$</td>
                                </tr>
