    <script>
        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
        }

        function searchContent() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.content-card');

            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                if (text.includes(query)) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }
            });
        }

        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                content.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }

        function calculatePhysics() {
            const m = parseFloat(document.getElementById('calcMass').value) || 0;
            const r = parseFloat(document.getElementById('calcRadius').value) || 0;
            const v = parseFloat(document.getElementById('calcVelocity').value) || 0;
            const mu = parseFloat(document.getElementById('calcMu').value) || 0;
            const g = 9.8;

            if (r > 0) {
                const omega = v / r;
                const ac = (v * v) / r;
                const fc = m * ac;
                const period = (2 * Math.PI) / omega;
                const vLevel = Math.sqrt(mu * r * g);
                const vLoop = Math.sqrt(5 * g * r);

                document.getElementById('resOmega').innerText = omega.toFixed(2) + ' rad/s';
                document.getElementById('resAc').innerText = ac.toFixed(2) + ' m/s²';
                document.getElementById('resFc').innerText = fc.toFixed(2) + ' N';
                document.getElementById('resPeriod').innerText = period.toFixed(2) + ' s';
                document.getElementById('resVlevel').innerText = vLevel.toFixed(2) + ' m/s';
                document.getElementById('resVloop').innerText = vLoop.toFixed(2) + ' m/s';
            }
        }

        let score = 0;
        const answered = {};

        function checkQuiz(qNum, opt, isCorrect, btn) {
            if (answered[qNum]) return;
            answered[qNum] = true;

            const expBox = document.getElementById('qexp-' + qNum);
            expBox.classList.remove('hidden');

            const parent = btn.parentElement;
            const buttons = parent.querySelectorAll('button');
            
            buttons.forEach(b => b.disabled = true);

            if (isCorrect) {
                btn.classList.add('bg-emerald-500', 'text-white');
                expBox.innerText = "Correct! Excellent grasp of the concept.";
                score++;
            } else {
                btn.classList.add('bg-rose-500', 'text-white');
                expBox.innerText = "Incorrect. Review the derivation and standard formulas above.";
            }

            document.getElementById('quizScore').innerText = `Score: ${score} / 3`;
        }

        /* Initialize Math Rendering on Load */
        window.onload = function() {
            calculatePhysics();
        };
