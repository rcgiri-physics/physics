                    <!-- Comparison Table -->
                    <h3 class="font-bold text-slate-900 dark:text-white text-lg mt-6">Analogy Between Linear and Angular Kinematics</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs sm:text-sm border-collapse border border-slate-200 dark:border-slate-700">
                            <thead>
                                <tr class="bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-white">
