// Cloudflare Worker + static assets for Physics Decoded (free plan).
// Static files in public/ are served directly by Cloudflare (free and unlimited); the Worker in
// worker/index.js only runs for /api/* and /admin/*. See README.md → "Deploying on Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physics-decoded",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Not --strict: a file with a problem is skipped (CI reports it) instead of blocking the whole deploy.
  "build": { "command": "python3 build.py" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "vars": {
    "GITHUB_REPO": "rcgiri-physics/physics",
    "GITHUB_BRANCH": "main"
  },
  // D1 (reports, contact messages, insights, login throttling). Create it once with
  //   npx wrangler d1 create physics-decoded
  // then uncomment the block below with the printed database_id, and run
  //   npx wrangler d1 execute physics-decoded --remote --file=worker/schema.sql
  // Until then the site and the editors work; only reports, messages and insights are unavailable.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "physics-decoded", "database_id": "<paste the id here>" }
  // ],
  "observability": { "enabled": true }
  // Secrets (never in this file): `npx wrangler secret put NAME` for
  //   SESSION_SECRET, ADMIN_USERS, GITHUB_TOKEN, and any AI keys (GROQ_API_KEY, GEMINI_API_KEY, …).
}
